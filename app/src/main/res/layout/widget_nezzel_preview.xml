<?xml version="1.0" encoding="utf-8"?>
<!-- Shared shape for every widget size: tokens and type live in values/widget.xml.
     Framework RemoteViews requires android:tint; AppCompat app:tint cannot apply here. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint"
    android:id="@android:id/background"
    style="@style/Widget.Nezzel.Root">
    <LinearLayout android:id="@+id/widget_paste" style="@style/Widget.Nezzel.Paste">
        <ImageView style="@style/Widget.Nezzel.PasteIcon" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView style="@style/Widget.Nezzel.Text.Label" android:text="@string/paste_link" />
            <TextView android:id="@+id/widget_saved_count" style="@style/Widget.Nezzel.Text.Count" android:text="@string/widget_empty_saved" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
