<?xml version="1.0" encoding="utf-8"?>
<!-- Framework RemoteViews requires android:tint; AppCompat app:tint cannot apply here. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="6dp"
    android:paddingTop="0dp"
    android:paddingBottom="0dp"
    android:background="@drawable/widget_background"
    android:layoutDirection="locale">
    <LinearLayout
        android:id="@+id/widget_paste"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@drawable/widget_button"
        android:contentDescription="@string/paste_link">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_paste"
            android:tint="@color/widget_on_primary"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_paste_short"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_on_primary"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/widget_saved_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/widget_on_primary"
                android:maxLines="1"
                android:ellipsize="end"
                android:textDirection="firstStrong"
                android:textAlignment="viewStart"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_slim_live"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/widget_paste_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="13dp"
            android:src="@drawable/ic_paste"
            android:tint="@color/widget_primary"
            android:contentDescription="@string/paste_link"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/widget_job"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/widget_on_surface"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textDirection="firstStrong"
                    android:textAlignment="viewStart"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/widget_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textColor="@color/widget_primary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textDirection="firstStrong"
                    android:textAlignment="viewStart"
                    android:importantForAccessibility="no" />
                <ProgressBar
                    android:id="@+id/widget_progress"
                    style="@android:style/Widget.Material.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:max="100"
                    android:progressDrawable="@drawable/widget_progress"
                    android:indeterminateTint="@color/widget_primary"
                    android:importantForAccessibility="no" />
                <ProgressBar
                    android:id="@+id/widget_progress_paused"
                    style="@android:style/Widget.Material.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:max="100"
                    android:progressDrawable="@drawable/widget_progress"
                    android:indeterminateTint="@color/widget_primary"
                    android:alpha="0.5"
                    android:visibility="gone"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/widget_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/widget_on_surface_variant"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textDirection="firstStrong"
                    android:textAlignment="viewStart"
                    android:importantForAccessibility="no" />
            </LinearLayout>
            <ImageView
                android:id="@+id/widget_control"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="13dp"
                android:src="@drawable/ic_pause"
                android:tint="@color/widget_primary"
                android:contentDescription="@string/pause" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_job_second"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_title_second"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/widget_on_surface"
                android:maxLines="1"
                android:ellipsize="end"
                android:textDirection="firstStrong"
                android:textAlignment="viewStart"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/widget_status_second"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/widget_primary"
                android:maxLines="1"
                android:ellipsize="end"
                android:textDirection="firstStrong"
                android:textAlignment="viewStart"
                android:importantForAccessibility="no" />
            <ProgressBar
                android:id="@+id/widget_progress_second"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:max="100"
                android:progressDrawable="@drawable/widget_progress"
                android:indeterminateTint="@color/widget_primary"
                android:importantForAccessibility="no" />
            <ProgressBar
                android:id="@+id/widget_progress_paused_second"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:max="100"
                android:progressDrawable="@drawable/widget_progress"
                android:indeterminateTint="@color/widget_primary"
                android:alpha="0.5"
                android:visibility="gone"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/widget_remaining_second"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/widget_on_surface_variant"
                android:maxLines="1"
                android:ellipsize="end"
                android:textDirection="firstStrong"
                android:textAlignment="viewStart"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <ImageView
            android:id="@+id/widget_control_second"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="13dp"
            android:src="@drawable/ic_pause"
            android:tint="@color/widget_primary"
            android:contentDescription="@string/pause" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_recents"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/widget_recent_1"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_tile"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_movie"
            android:contentDescription="@string/open_file"
            android:visibility="gone" />
        <TextView
            android:id="@+id/widget_recent_gap_1"
            android:layout_width="8dp"
            android:layout_height="1dp"
            android:importantForAccessibility="no"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/widget_recent_2"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_tile"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_movie"
            android:contentDescription="@string/open_file"
            android:visibility="gone" />
        <TextView
            android:id="@+id/widget_recent_gap_2"
            android:layout_width="8dp"
            android:layout_height="1dp"
            android:importantForAccessibility="no"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/widget_recent_3"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_tile"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_movie"
            android:contentDescription="@string/open_file"
            android:visibility="gone" />
        <TextView
            android:id="@+id/widget_recent_gap_3"
            android:layout_width="8dp"
            android:layout_height="1dp"
            android:importantForAccessibility="no"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/widget_recent_4"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:layout_marginEnd="0dp"
            android:background="@drawable/widget_tile"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_movie"
            android:contentDescription="@string/open_file"
            android:visibility="gone" />
    </LinearLayout>
    <TextView
        android:id="@+id/widget_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/widget_primary"
        android:maxLines="1"
        android:ellipsize="end"
        android:textDirection="firstStrong"
        android:textAlignment="viewStart"
        android:visibility="gone" />
</LinearLayout>
